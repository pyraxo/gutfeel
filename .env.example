# Local development defaults. Production requires an exact HTTPS origin.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://localhost:4173

# Public deployments must link to the exact source corresponding to the
# JavaScript/WASM and server build they distribute.
SOURCE_CODE_URL=

# Set only to the exact addresses of reverse proxies you control.
TRUSTED_PROXY_IPS=
