+/// Find the one Flash sprite visibly exposed at a stage point.
+///
+/// Flash is rendered into an off-screen Ruffle canvas, so it needs a separate
+/// input route from the ordinary Director target. Walk the score in its paint
+/// order and stop at the first foreground pixel: a fully transparent bitmap
+/// pixel does not mask the Flash beneath it, while an opaque bitmap or any
+/// other visible foreground member does. This selects one recipient only;
+/// hidden or lower Flash movies never receive a broadcast click.
+///
+/// This deliberately does not replace normal Director mouse dispatch. The
+/// caller still records and invokes the frontmost Director sprite as usual;
+/// it only adds the embedded Flash press/release required for its AVM button.
+fn get_flash_sprite_at(
+    player: &crate::player::DirPlayer,
+    x: i32,
+    y: i32,
+) -> Option<(i32, i32, i32, i32, i32)> {
+    for channel in player
+        .movie
+        .score
+        .get_sorted_channels(player.movie.current_frame)
+        .iter()
+        .rev()
+    {
+        let sprite = &channel.sprite;
+        if !concrete_sprite_hit_test(player, sprite, x, y) {
+            continue;
+        }
+        let Some(member_ref) = sprite.member.as_ref() else {
+            continue;
+        };
+        let Some(member) = player.movie.cast_manager.find_member_by_ref(member_ref) else {
+            continue;
+        };
+        if !matches!(member.member_type, CastMemberType::Flash(_)) {
+            if sprite_visually_occludes_point(player, sprite, x, y) {
+                return None;
+            }
+            continue;
+        }
+        let rect = get_concrete_sprite_rect(player, sprite);
+        return Some((
+            sprite.number as i32,
+            x - rect.left,
+            y - rect.top,
+            rect.right - rect.left,
+            rect.bottom - rect.top,
+        ));
+    }
+    None
+}
