@@ -17,6 +17,67 @@ use super::prop_list::PropListUtils;
 
 pub struct BitmapDatumHandlers {}
 
+/// Director scripts occasionally use an uninitialized rectangle variable as
+/// the destination of an initial image.copyPixels call. The operation has no
+/// drawable destination and is a no-op; subsequent calls commonly assign a
+/// real rectangle and perform the visible initialization.
+fn is_empty_copy_destination(value: &Datum) -> bool {
+    value.is_void()
+        || matches!(value, Datum::Null)
+        || (value.is_number() && value.int_value().is_ok_and(|number| number == 0))
+}
+
+/// Runtime text images carry glyph coverage in alpha and leave their unused
+/// canvas RGB black. Preserve that coverage when such a bitmap is supplied as
+/// `#maskImage`; non-alpha masks retain Director's white-transparent /
+/// black-opaque RGB rule.
+fn mask_pixel_is_opaque(
+    bitmap: &Bitmap,
+    palettes: &crate::player::bitmap::palette_map::PaletteMap,
+    x: u16,
+    y: u16,
+) -> bool {
+    if bitmap.original_bit_depth == 32 && bitmap.use_alpha {
+        let (_, _, _, alpha) = bitmap.get_pixel_color_with_alpha(palettes, x, y);
+        alpha != 0
+    } else {
