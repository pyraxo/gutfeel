+        let palettes = PaletteMap::new();
+        let mut bitmap = Bitmap::new(37, 19, 32, 32, 8,
+            PaletteRef::BuiltIn(BuiltInPalette::SystemWin));
+        bitmap.use_alpha = true;
+        for (i, pixel) in bitmap.data.chunks_exact_mut(4).enumerate() {
+            pixel.copy_from_slice(&[(i * 71) as u8, (i * 37) as u8, (i * 131) as u8,
+                [0, 1, 127, 179, 254, 255][i % 6]]);
+        }
+        for bg in [None, Some((255, 255, 255)), Some((0, 0, 0))] {
+            for colorize in [None, Some((false, false, 1, 2, 3, 4, 5, 6)),
+                Some((true, false, 255, 0, 0, 255, 255, 255))] {
+                let actual = WebGL2Renderer::bitmap_to_rgba(&bitmap, &palettes, 36,
+                    colorize, bg, None, (0, 0), true);
+                let reference = WebGL2Renderer::bitmap_to_rgba_general(&bitmap, &palettes, 36,
+                    colorize, bg, None, (0, 0), true);
+                assert_eq!(actual, reference);
+                if colorize.is_none() { assert_eq!(actual, bitmap.data); }
+            }
+        }
+    }
+
+    #[test]
+    fn authored_alpha_and_tinted_flash_keep_existing_processing() {
+        let palettes = PaletteMap::new();
+        let mut bitmap = Bitmap::new(2, 1, 32, 32, 8,
+            PaletteRef::BuiltIn(BuiltInPalette::SystemWin));
+        bitmap.use_alpha = true;
+        bitmap.data.copy_from_slice(&[255, 255, 255, 179, 30, 80, 170, 127]);
+        let plain = WebGL2Renderer::bitmap_to_rgba(&bitmap, &palettes, 36,
+            None, Some((255, 255, 255)), None, (0, 0), false);
+        assert_eq!(plain[3], 0, "authored bitmap keeps its white colour key");
+        let tinted = WebGL2Renderer::bitmap_to_rgba(&bitmap, &palettes, 36,
+            Some((true, false, 255, 0, 0, 255, 255, 255)), None, None, (0, 0), true);
+        let reference = WebGL2Renderer::bitmap_to_rgba_general(&bitmap, &palettes, 36,
+            Some((true, false, 255, 0, 0, 255, 255, 255)), None, None, (0, 0), true);
+        assert_eq!(tinted, reference);
+        assert_ne!(tinted, bitmap.data, "tint must not be bypassed");
+    }
+}
+
+#[cfg(test)]
+mod direct_flash_canvas_tests {
+    use super::direct_flash_canvas_allowed;
+    #[test]
+    fn direct_canvas_keeps_tints_masks_and_nested_players_on_pixel_path() {
+        for ink in [0, 36] {
+            assert!(direct_flash_canvas_allowed(ink, false, true));
+            assert!(!direct_flash_canvas_allowed(ink, true, true));
+            assert!(!direct_flash_canvas_allowed(ink, false, false));
+        }
+        for ink in [1, 7, 8, 9, 32, 33, 41] {
+            assert!(!direct_flash_canvas_allowed(ink, false, true));
+        }
+    }
+}
