+/// Browser relay implementation of Director's `waitForNetConnection`.
+///
+/// Native Director binds a TCP port and returns once the listener exists. A
+/// browser cannot bind a TCP socket, so this opens a WebSocket relay endpoint
+/// for the same advertised address/port. Returning zero means the browser
+/// accepted the listener request; relay join/leave events are still delivered
+/// through the original `WaitForNetConnection` / `ConnectionProblem` subjects.
+/// A constructor failure returns `-1`; sends remain errors until `onopen`.
+fn wait_for_peer_relay(instance_id: u32, args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let (user_id, local_address, local_port, max_connections, encryption_key) =
+        reserve_player_ref(|player| {
+            let first = args.get(0).ok_or_else(|| {
+                ScriptError::new("WaitForNetConnection requires listener details".to_string())
+            })?;
+            if let Datum::PropList(pairs, _) = player.get_datum(first) {
+                let property = |wanted: &str| {
+                    pairs.iter().find_map(|(key, value)| {
+                        let key_name = player.get_datum(key).string_value().ok()?;
+                        key_name.eq_ignore_ascii_case(wanted).then(|| value.clone())
+                    })
+                };
+                let user = property("userID")
+                    .map(|value| player.get_datum(&value).string_value())
+                    .transpose()?
+                    .unwrap_or_default();
+                let address = property("localAddress")
+                    .map(|value| player.get_datum(&value).string_value())
+                    .transpose()?
+                    .filter(|value| !value.is_empty())
+                    .unwrap_or_else(|| "localhost".to_string());
+                let port = property("localTCPPort")
+                    .map(|value| player.get_datum(&value).int_value())
+                    .transpose()?
+                    .unwrap_or(0);
+                let max_connections = property("maxConnections")
+                    .map(|value| player.get_datum(&value).int_value())
+                    .transpose()?
+                    .unwrap_or(1);
+                let encryption = property("encryptionKey")
+                    .map(|value| player.get_datum(&value).string_value())
+                    .transpose()?
+                    .unwrap_or_default();
+                Ok((user, address, port, max_connections, encryption))
+            } else {
+                let user = player.get_datum(first).string_value()?;
+                let port = args
+                    .get(1)
+                    .map(|value| player.get_datum(value).int_value())
+                    .transpose()?
+                    .unwrap_or(0);
+                let max_connections = args
+                    .get(2)
+                    .map(|value| player.get_datum(value).int_value())
+                    .transpose()?
+                    .unwrap_or(1);
+                let encryption = args
+                    .get(3)
+                    .map(|value| player.get_datum(value).string_value())
+                    .transpose()?
+                    .unwrap_or_default();
+                Ok((
+                    user,
+                    "localhost".to_string(),
+                    port,
+                    max_connections,
+                    encryption,
+                ))
+            }
+        })?;
+
+    if user_id.is_empty() || local_port <= 0 || max_connections <= 0 {
+        multiuser_log!(
+            "Multiuser: refusing invalid peer listener user='{}' address='{}' port={} max={}",
+            user_id,
+            local_address,
+            local_port,
+            max_connections
+        );
+        return reserve_player_mut(|player| Ok(player.alloc_datum(Datum::Int(-1))));
+    }
+
+    let ws_url = resolve_peer_relay_url(&local_address, local_port, &user_id, max_connections);
+    let socket = match WebSocket::new(&ws_url) {
+        Ok(socket) => socket,
+        Err(error) => {
+            multiuser_log!(
+                "Multiuser: unable to create peer relay socket for {}:{}: {:?}",
+                local_address,
+                local_port,
+                error
+            );
+            return reserve_player_mut(|player| Ok(player.alloc_datum(Datum::Int(-1))));
+        }
+    };
+    socket.set_binary_type(web_sys::BinaryType::Arraybuffer);
+
+    let multiusr_manager = unsafe { MULTIUSER_XTRA_MANAGER_OPT.as_mut().unwrap() };
+    let instance = multiusr_manager
+        .instances
+        .get_mut(&instance_id)
+        .ok_or_else(|| {
+            ScriptError::new(format!("Unknown Multiuser xtra instance #{}", instance_id))
+        })?;
+    if instance.socket_tx.is_some() || instance.is_connected {
+        return reserve_player_mut(|player| Ok(player.alloc_datum(Datum::Int(-1))));
+    }
+    instance.sender_id = user_id.clone();
+    instance.connection_mode = MultiuserConnectionMode::Binary;
+
+    let (tx, rx) = async_std::channel::unbounded();
+    instance.socket_tx = Some(tx);
+    instance.socket = Some(socket.clone());
+    let socket_clone = socket.clone();
+    let conn_generation = unsafe { crate::player::PLAYER_GENERATION };
+
+    let onmessage_callback = Closure::<dyn FnMut(_)>::new(move |event: MessageEvent| {
+        if unsafe { crate::player::PLAYER_GENERATION } != conn_generation {
+            return;
+        }
+        let data = event.data();
+        let bytes = if let Ok(array_buffer) = data.dyn_into::<js_sys::ArrayBuffer>() {
+            js_sys::Uint8Array::new(&array_buffer).to_vec()
+        } else {
+            multiuser_log!("Multiuser: peer relay returned a non-binary message");
+            return;
+        };
+        if let Some(manager) = unsafe { MULTIUSER_XTRA_MANAGER_OPT.as_mut() } {
+            if let Some(instance) = manager.instances.get_mut(&instance_id) {
+                instance.receive_binary_data(&bytes);
+            }
+        }
+    });
+
+    let onerror_callback = Closure::<dyn FnMut(_)>::new(move |_event: Event| {
+        if unsafe { crate::player::PLAYER_GENERATION } != conn_generation {
+            return;
+        }
+        if let Some(manager) = unsafe { MULTIUSER_XTRA_MANAGER_OPT.as_mut() } {
+            if let Some(instance) = manager.instances.get_mut(&instance_id) {
+                instance.is_connected = false;
+                instance.dispatch_message(MultiuserMessage {
+                    error_code: -1,
+                    recipients: vec![],
+                    sender_id: "System".to_string(),
+                    subject: "ConnectionProblem".to_string(),
+                    content: StaticDatum::String("Peer relay WebSocket error".to_string()),
+                    time_stamp: 0,
+                });
+            }
+        }
+    });
+
+    let onclose_callback = Closure::<dyn FnMut(_)>::new(move |event: CloseEvent| {
+        if unsafe { crate::player::PLAYER_GENERATION } != conn_generation {
+            return;
+        }
+        if let Some(manager) = unsafe { MULTIUSER_XTRA_MANAGER_OPT.as_mut() } {
+            if let Some(instance) = manager.instances.get_mut(&instance_id) {
+                instance.is_connected = false;
+                // This relay socket represents the native peer listener. On
+                // relay loss, synthesize its per-client disconnect callbacks
+                // so muHost removes ppConUsers and broadcasts userLogOff.
+                let peers = std::mem::take(&mut instance.peer_connections);
+                let messages = peer_host_disconnect_messages(peers);
+                if messages.is_empty() {
+                    instance.dispatch_message(transport_connection_problem(event.reason()));
+                } else {
+                    for message in messages {
+                        instance.dispatch_message(message);
+                    }
+                }
+            }
+        }
+    });
+
+    let onopen_callback = Closure::<dyn FnMut(_)>::new(move |_event: Event| {
+        if unsafe { crate::player::PLAYER_GENERATION } != conn_generation {
+            return;
+        }
+        let Some(manager) = (unsafe { MULTIUSER_XTRA_MANAGER_OPT.as_mut() }) else {
+            return;
+        };
+        let Some(instance) = manager.instances.get_mut(&instance_id) else {
+            return;
+        };
+        instance.is_connected = true;
+        let mut cipher = MUSBlowfish::new(&resolved_multiuser_encryption_key(&encryption_key));
+        let logon = MultiuserMessage {
+            error_code: 0,
+            recipients: vec!["System".to_string()],
+            sender_id: user_id.clone(),
+            subject: "Logon".to_string(),
+            content: StaticDatum::List(vec![
+                StaticDatum::String("peer-relay".to_string()),
+                StaticDatum::String(user_id.clone()),
+                StaticDatum::String(String::new()),
+            ]),
+            time_stamp: 0,
+        };
+        let Some(tx) = &instance.socket_tx else {
+            instance.is_connected = false;
+            return;
+        };
+        if tx.try_send(logon.to_bytes(Some(&mut cipher))).is_err() {
+            instance.is_connected = false;
+            instance.dispatch_message(MultiuserMessage {
+                error_code: -1,
+                recipients: vec![],
+                sender_id: "System".to_string(),
+                subject: "ConnectionProblem".to_string(),
+                content: StaticDatum::String("Peer relay send queue closed".to_string()),
+                time_stamp: 0,
+            });
+        }
+    });
+
+    socket.set_onmessage(Some(onmessage_callback.as_ref().unchecked_ref()));
+    socket.set_onerror(Some(onerror_callback.as_ref().unchecked_ref()));
+    socket.set_onclose(Some(onclose_callback.as_ref().unchecked_ref()));
+    socket.set_onopen(Some(onopen_callback.as_ref().unchecked_ref()));
+    crate::player::spawn_player_local(async move {
+        while let Ok(message) = rx.recv().await {
+            if socket_clone.ready_state() != WebSocket::OPEN {
+                multiuser_log!("Multiuser: peer relay send rejected before socket open");
+                continue;
+            }
+            if let Err(error) = socket_clone.send_with_u8_array(&message) {
+                multiuser_log!("Multiuser: peer relay send failed: {:?}", error);
+            }
+        }
+    });
+    onmessage_callback.forget();
+    onerror_callback.forget();
+    onclose_callback.forget();
+    onopen_callback.forget();
+
+    reserve_player_mut(|player| Ok(player.alloc_datum(Datum::Int(0))))
+}
+
+fn resolved_multiuser_encryption_key(encryption_key: &str) -> Vec<u8> {
+    if encryption_key.is_empty() {
+        DEFAULT_CIPHER_KEY.to_vec()
+    } else if encryption_key.len() < 20 {
+        let mut key = DEFAULT_CIPHER_KEY.to_vec();
+        key.extend_from_slice(encryption_key.as_bytes());
+        key
+    } else {
+        encryption_key.as_bytes().to_vec()
+    }
+}
+
+/// Resolve a relay endpoint through the page's existing socket resolver. The
+/// third argument is structured metadata for the Gut Feel host bridge; older
+/// two-argument resolvers simply ignore it and return their normal URL.
+fn resolve_peer_relay_url(address: &str, port: i32, user_id: &str, max_connections: i32) -> String {
+    let secure = web_sys::window()
+        .and_then(|window| window.location().protocol().ok())
+        .is_some_and(|protocol| protocol == "https:");
+    let scheme = if secure { "wss" } else { "ws" };
+    let default_url = format!("{}://{}:{}", scheme, address, port);
+    let Some(window) = web_sys::window() else {
+        return default_url;
+    };
+    let Ok(resolver) = js_sys::Reflect::get(&window, &"dirplayerResolveSocketUrl".into()) else {
+        return default_url;
+    };
+    let Some(resolver) = resolver.dyn_ref::<js_sys::Function>() else {
+        return default_url;
+    };
+    let metadata = js_sys::Object::new();
+    let _ = js_sys::Reflect::set(&metadata, &"kind".into(), &"peer-host".into());
+    let _ = js_sys::Reflect::set(&metadata, &"userId".into(), &user_id.into());
+    let _ = js_sys::Reflect::set(
+        &metadata,
+        &"maxConnections".into(),
+        &(max_connections as f64).into(),
+    );
+    resolver
+        .call3(
+            &wasm_bindgen::JsValue::NULL,
+            &address.into(),
+            &wasm_bindgen::JsValue::from_f64(port as f64),
+            &metadata.into(),
+        )
+        .ok()
+        .and_then(|value| value.as_string())
+        .filter(|url| !url.is_empty())
+        .unwrap_or(default_url)
+}
