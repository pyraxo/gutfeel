+/// Whether a sprite that geometrically contains a point actually contributes a
+/// visible pixel there. This is intentionally separate from Director's normal
+/// `get_sprite_at` hit test: that API uses a sprite's rectangle for most ink
+/// modes, while an off-screen Flash player must only receive input through a
+/// transparent bitmap overlay when its own pixels remain visible.
+///
+/// The common case is a 32-bit `#bgTransparent` HUD bitmap. Its transparent
+/// areas still occupy the whole score rectangle for Director mouse dispatch,
+/// but do not visually occlude a Flash button behind them. Other sprite types
+/// are conservatively considered occluding once their rectangle hit succeeds.
+pub fn sprite_visually_occludes_point(
+    player: &DirPlayer,
+    sprite: &Sprite,
+    x: i32,
+    y: i32,
+) -> bool {
+    if !concrete_sprite_hit_test(player, sprite, x, y) || sprite.effective_blend() == 0 {
+        return false;
+    }
+
+    let Some(member_ref) = sprite.member.as_ref() else {
+        return false;
+    };
+    let Some(member) = player.movie.cast_manager.find_member_by_ref(member_ref) else {
+        return false;
+    };
+    let CastMemberType::Bitmap(bitmap_member) = &member.member_type else {
+        // A rendered non-bitmap has no general per-pixel source available at
+        // this stage. Keep it in the visible stack instead of clicking through
+        // a potentially opaque foreground member.
+        return true;
+    };
+    let Some(bitmap) = player.bitmap_manager.get_bitmap(bitmap_member.image_ref) else {
+        return true;
+    };
+
+    // `concrete_sprite_hit_test` handles transformed bounds, but mapping a
+    // pixel through rotation/skew would need the renderer's complete matrix.
+    // Treat those foreground sprites as occluding rather than guessing.
+    if sprite.rotation.abs() > 0.1 || sprite.has_skew_flip() {
+        return true;
+    }
+
+    let rect = get_concrete_sprite_rect(player, sprite);
+    let rect_w = (rect.right - rect.left).max(1);
+    let rect_h = (rect.bottom - rect.top).max(1);
+    let mut bx = ((x - rect.left) * bitmap.width as i32 / rect_w)
+        .clamp(0, bitmap.width.saturating_sub(1) as i32) as u16;
+    let mut by = ((y - rect.top) * bitmap.height as i32 / rect_h)
+        .clamp(0, bitmap.height.saturating_sub(1) as i32) as u16;
+    if sprite.flip_h {
+        bx = bitmap.width.saturating_sub(1).saturating_sub(bx);
+    }
+    if sprite.flip_v {
+        by = bitmap.height.saturating_sub(1).saturating_sub(by);
+    }
+
+    let palettes = player.movie.cast_manager.palettes();
+    let (r, g, b, a) = bitmap.get_pixel_color_with_alpha(&palettes, bx, by);
+    if bitmap.use_alpha && a == 0 {
+        return false;
+    }
+
+    // The renderer color-keys the authored background for #transparent / #bg
+    // transparent (inks 2 and 36). Match that exact test so an opaque legacy
+    // bitmap with a keyed background also lets the visible Flash layer receive
+    // its press; all other pixels continue to occlude it.
