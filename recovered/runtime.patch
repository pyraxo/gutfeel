+/// The third-party DisplayMode Xtra stored as an OLE cast member.
+///
+/// Native Director used this Xtra to switch the monitor resolution. A browser
+/// cannot change the operating-system display mode, but retaining the request
+/// lets the authored Lingo continue and resize `the stage.rect` itself.
+#[derive(Clone, Debug, PartialEq)]
+pub struct DisplayModeMember {
+    pub width: u32,
+    pub height: u32,
+    pub bits_per_pixel: u32,
+}
+
+impl DisplayModeMember {
+    pub fn from_ole_data(raw: &[u8]) -> Self {
+        // displayMode 4.0 stores these three little-endian values 32 bytes
+        // from the end of its member data. Gut Feel authored 800 x 600 x 32.
+        let read_u32_le = |offset: usize| {
+            raw.get(offset..offset + 4)
+                .and_then(|bytes| bytes.try_into().ok())
+                .map(u32::from_le_bytes)
+        };
+        let settings = raw.len().checked_sub(32).and_then(|offset| {
+            Some((
+                read_u32_le(offset)?,
+                read_u32_le(offset + 4)?,
+                read_u32_le(offset + 8)?,
+            ))
+        });
+        let (width, height, bits_per_pixel) = settings
+            .filter(|(width, height, bits)| *width > 0 && *height > 0 && *bits > 0)
+            .unwrap_or((800, 600, 32));
+        Self { width, height, bits_per_pixel }
+    }
+
+    pub fn set_option(&mut self, key: &str, value: i32) -> Result<(), ScriptError> {
+        if value <= 0 {
+            return Err(ScriptError::new(format!(
+                "DisplayMode {} must be positive",
+                key
+            )));
+        }
+        match key.to_ascii_lowercase().as_str() {
+            "width" => self.width = value as u32,
+            "height" => self.height = value as u32,
+            "bitsperpixel" => self.bits_per_pixel = value as u32,
+            _ => {}
+        }
+        Ok(())
+    }
