+vm_rust::native_e2e_test!(gutfeel_gnotice_mask_copy_preserves_the_banner_under_text, |player| async move {
+    player.load_movie(&browser_ready_client()).await;
+
+    // This invokes the recovered actor's mPrepareNextNotice handler. It is the
+    // exact notice composition route, with its queue state installed directly
+    // to avoid native AudioContext setup in the following actor stepFrame.
+    for command in [
+        "gNotice = script(\"gnotice\").new()",
+        "gNotice.myCurrentQues = [[1, \"QA notice\"]]",
+        "gNotice.pType = #displaywhiteBox",
+        "gNotice.mPrepareNextNotice()",
+    ] {
+        player.eval(command).await.map_err(|error| error.to_string())?;
+    }
+
+    let (width, height, has_alpha, source_background) = bitmap_rgba_by_name("msg_bg");
+    let (banner_width, banner_height, banner_has_alpha, notice_banner) =
+        bitmap_rgba_by_name("Notice_Banner");
+    assert_eq!((banner_width, banner_height), (width, height));
+    assert!(has_alpha && banner_has_alpha);
+
+    // `mPrepareNextNotice` starts from `member("MSG_bg").image.duplicate()`.
+    // #maskImage must restrict the text copy to glyph coverage; it must never
+    // replace an opaque/translucent banner pixel with transparent source alpha.
+    for (pixel_index, (background, banner)) in source_background
+        .chunks_exact(4)
+        .zip(notice_banner.chunks_exact(4))
+        .enumerate()
+    {
+        if background[3] != 0 {
+            assert_ne!(
+                banner[3],
+                0,
+                "notice text copy erased msg_bg at ({}, {})",
+                pixel_index % width as usize,
+                pixel_index / width as usize,
+            );
+        }
+    }
+
+    Ok(())
+});
