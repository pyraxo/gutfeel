+/**
+ * Timelines keep ticking independently; only redundant CPU snapshots stop.
+ * @param {{captureEnabled?: boolean, directCanvas?: boolean}} state
+ * @param {boolean} offscreenTexture
+ * @param {number} rafCount
+ */
+export function needsFlashReadback(state, offscreenTexture, rafCount) {
+  if (offscreenTexture) return rafCount % 10 === 0;
+  return state.captureEnabled !== false && state.directCanvas !== true;
+}
diff --git a/src/services/flashCapturePolicy.js b/src/services/flashCapturePolicy.js
new file mode 100644
index 0000000..1ee90cd
--- /dev/null
+++ b/src/services/flashCapturePolicy.js
@@ -0,0 +1,70 @@
+// Flash readback policy kept separate so its dimensions and cadence can be
+// regression-tested without constructing Ruffle, canvas, or WASM instances.
+
+export function captureDimensions(
+  requestedWidth,
+  requestedHeight,
+  nativeWidth,
+  nativeHeight,
+  _sourceWidth,
+  _sourceHeight,
+) {
+  // Ruffle's canvas backing size follows devicePixelRatio. The Director stage
+  // consumes logical sprite pixels, so uploading the physical backing store
+  // would multiply both readback and WASM-copy cost without adding visible
+  // detail. Preserve the SWF's authored stage size as the detail floor.
+  return {
+    width: Math.max(1, Math.round(requestedWidth || 1), Math.round(nativeWidth || 0)),
+    height: Math.max(1, Math.round(requestedHeight || 1), Math.round(nativeHeight || 0)),
+  };
+}
+
+export function captureRate(directorTempo, swfFrameRate, maxFramesPerSecond = 0) {
+  const positive = [directorTempo, swfFrameRate]
+    .map(Number)
+    .filter(value => Number.isFinite(value) && value > 0);
+  // Twenty-four is the renderer's established fallback when neither producer
+  // reports a useful rate. A host may lower readback frequency independently
+  // of both producers (for example while its iframe is hidden); absent a
+  // positive host cap, preserve the producer cadence exactly.
+  const producerRate = positive.length ? Math.min(...positive) : 24;
+  const cap = Number(maxFramesPerSecond);
+  return Number.isFinite(cap) && cap > 0 ? Math.min(producerRate, cap) : producerRate;
+}
+
+export function createCaptureSchedule() {
+  return {lastCaptureAtMs: null, nextCaptureAtMs: null, framesPerSecond: 0};
+}
+
+export function shouldCapture(schedule, nowMs, framesPerSecond) {
+  syncRate(schedule, framesPerSecond);
+  return schedule.nextCaptureAtMs == null || nowMs >= schedule.nextCaptureAtMs;
+}
+
+export function recordCapture(schedule, nowMs, framesPerSecond) {
+  const fps = syncRate(schedule, framesPerSecond);
+  const period = 1000 / fps;
+  schedule.lastCaptureAtMs = nowMs;
+  if (schedule.nextCaptureAtMs == null) {
+    schedule.nextCaptureAtMs = nowMs + period;
+    return;
+  }
+  if (schedule.nextCaptureAtMs <= nowMs) {
+    const missed = Math.floor((nowMs - schedule.nextCaptureAtMs) / period) + 1;
+    schedule.nextCaptureAtMs += missed * period;
+    // Floating point rounding at exact boundaries must never leave a deadline
+    // at or behind `now`, which would trigger a catch-up read on the next RAF.
+    if (schedule.nextCaptureAtMs <= nowMs) schedule.nextCaptureAtMs += period;
+  }
+}
+
+function syncRate(schedule, framesPerSecond) {
+  const fps = captureRate(framesPerSecond, 0);
+  if (schedule.framesPerSecond !== fps) {
+    schedule.framesPerSecond = fps;
+    schedule.nextCaptureAtMs = schedule.lastCaptureAtMs == null
+      ? null
+      : schedule.lastCaptureAtMs + 1000 / fps;
+  }
+  return fps;
+}
diff --git a/vm-rust/src/player/xtra/gutfeel.rs b/vm-rust/src/player/xtra/gutfeel.rs
new file mode 100644
index 0000000..c7d214a
--- /dev/null
+++ b/vm-rust/src/player/xtra/gutfeel.rs
@@ -0,0 +1,1052 @@
+//! Native compatibility shim for Gut Feel's external goMU movie.
+//!
+//! The original linked movie supplies a small aliasing layer over the
+//! Multiuser Xtra (`goMU.muNew`, `alias.muPost`, and `alias.mMsg`). Loading
+//! that movie as a nested Director player does not share globals with the game,
+//! so this module provides only that wrapper surface. Gameplay remains the
+//! original client Lingo and messages remain original MUS frames.
+
+use fxhash::FxHashMap;
+
+use crate::{
+    director::lingo::datum::Datum,
+    player::{
+        DatumRef, ScriptError,
+        handlers::datum_handlers::player_call_datum_handler,
+        reserve_player_mut, reserve_player_ref,
+        script::script_get_prop,
+        symbols::symbol::Symbol,
+        xtra::{
+            manager::call_xtra_instance_handler,
+            multiuser::{MultiuserXtraManager, borrow_multiuser_manager_mut},
+        },
+    },
+};
+
+const XTRA_NAME: &str = "gutfeel-gomu";
+
+struct NotifyTarget {
+    receiver: DatumRef,
+    handler: Symbol,
+}
+
+struct GoMuInstance {
+    alias: String,
+    user: String,
+    password: String,
+    kind: String,
+    movie: String,
+    peer_port: i32,
+    max_connections: i32,
+    max_attempts: u32,
+    keep_alive: bool,
+    reconnect_interval_ms: u64,
+    reconnect_attempts: u32,
+    reconnect_pending: bool,
+    reconnect_token: u64,
+    multiuser_id: u32,
+    m_server: String,
+    pp_con_str: String,
+    status: i32,
+    last_message: DatumRef,
+    default_notify: Option<NotifyTarget>,
+    notify_by_subject: FxHashMap<String, NotifyTarget>,
+}
+
+#[derive(Default)]
+struct GoMuManager {
+    instances: FxHashMap<u32, GoMuInstance>,
+    aliases: FxHashMap<String, u32>,
+    next_id: u32,
+}
+
+static mut GOMU_MANAGER: Option<GoMuManager> = None;
+
+fn manager() -> &'static mut GoMuManager {
+    unsafe { GOMU_MANAGER.get_or_insert_with(GoMuManager::default) }
+}
+
+pub struct GoMuXtra;
+
+impl GoMuXtra {
+    pub fn has_static_handler(name: &str) -> bool {
+        name.eq_ignore_ascii_case("goMUstart")
+    }
+
+    pub fn call_static_handler(name: &str, args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+        if !Self::has_static_handler(name) {
+            return Err(ScriptError::new(format!(
+                "Unknown goMU static handler {name}"
+            )));
+        }
+        start(args)
+    }
+
+    pub fn call_instance_handler(
+        instance_id: u32,
+        handler_name: &str,
+        args: &Vec<DatumRef>,
+    ) -> Result<DatumRef, ScriptError> {
+        match handler_name.to_ascii_lowercase().as_str() {
+            "munew" => mu_new(args),
+            "mu" | "mugetref" => lookup_alias(args),
+            "mupost" | "mupostw" => mu_post(instance_id, args),
+            "webmessage" => Err(ScriptError::new(
+                "webMessage is dispatched asynchronously".to_string(),
+            )),
+            "kill" | "mukill" | "mureset" | "reset" => kill_instance(instance_id),
+            "mugetnacs" => ok_list(&["localhost"]),
+            "mugetnes" => ok_int(-1),
+            "debugoff" | "debugon" | "mudump" => Ok(DatumRef::Void),
+            _ => Err(ScriptError::new(format!(
+                "Unsupported native goMU method {handler_name}"
+            ))),
+        }
+    }
+}
+
+pub fn has_instance_async_handler(handler_name: &str) -> bool {
+    handler_name.eq_ignore_ascii_case("webMessage")
+}
+
+pub async fn call_instance_async_handler(
+    instance_id: u32,
+    handler_name: &str,
+    _args: &Vec<DatumRef>,
+) -> Result<DatumRef, ScriptError> {
+    if !has_instance_async_handler(handler_name) {
+        return Err(ScriptError::new(format!(
+            "No async goMU handler {handler_name}"
+        )));
+    }
+    web_message(instance_id).await
+}
+
+/// `goMUstart` normally returns the external muMain parent-script instance.
+/// The root shim is an XtraInstance so calls from legacy Lingo retain object
+/// method syntax (`goMU.muNew(...)`).
+fn start(_args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let root_exists = manager().instances.contains_key(&0);
+    if !root_exists {
+        manager().instances.insert(
+            0,
+            GoMuInstance {
+                alias: "goMU".to_string(),
+                user: String::new(),
+                password: String::new(),
+                kind: "root".to_string(),
+                movie: String::new(),
+                peer_port: 0,
+                max_connections: 0,
+                max_attempts: 0,
+                keep_alive: false,
+                reconnect_interval_ms: 0,
+                reconnect_attempts: 0,
+                reconnect_pending: false,
+                reconnect_token: 0,
+                multiuser_id: 0,
+                m_server: String::new(),
+                pp_con_str: String::new(),
+                status: 1,
+                last_message: DatumRef::Void,
+                default_notify: None,
+                notify_by_subject: FxHashMap::default(),
+            },
+        );
+        manager().aliases.insert("gomu".to_string(), 0);
+    }
+    reserve_player_mut(|player| {
+        let shim = player.alloc_datum(Datum::XtraInstance(XTRA_NAME.to_string(), 0));
+        player
+            .globals
+            .insert(Symbol::from_str("goMU"), shim.clone());
+        Ok(shim)
+    })
+}
+
+fn mu_new(args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let config = args
+        .first()
+        .ok_or_else(|| ScriptError::new("goMU.muNew requires a property list".to_string()))?;
+    let parsed = reserve_player_ref(|player| parse_config(player, config))?;
+    if manager()
+        .aliases
+        .contains_key(&parsed.alias.to_ascii_lowercase())
+    {
+        return Err(ScriptError::new(format!(
+            "goMU alias already exists: {}",
+            parsed.alias
+        )));
+    }
+    let multiuser_id = borrow_multiuser_manager_mut(|manager| manager.create_instance(&vec![]));
+    let instance_id = {
+        let state = manager();
+        state.next_id += 1;
+        state.next_id
+    };
+    let shim_ref = reserve_player_mut(|player| {
+        Ok(player.alloc_datum(Datum::XtraInstance(XTRA_NAME.to_string(), instance_id)))
+    })?;
+
+    let handler_args = reserve_player_mut(|player| {
+        let handler = player.alloc_datum(Datum::Symbol(Symbol::from_str("webMessage")));
+        Ok(vec![handler, shim_ref.clone()])
+    })?;
+    MultiuserXtraManager::call_instance_handler(
+        "setNetMessageHandler",
+        multiuser_id,
+        &handler_args,
+    )?;
+
+    let is_peer =
+        parsed.kind.eq_ignore_ascii_case("ppH") || parsed.kind.eq_ignore_ascii_case("ppC");
+    let (host, port) = split_server(
+        &parsed.server,
+        if is_peer { parsed.peer_port } else { 1626 },
+    );
+    let connect_args = reserve_player_mut(|player| {
+        let user = player.alloc_datum(Datum::String(parsed.user.clone()));
+        let password = player.alloc_datum(Datum::String(parsed.password.clone()));
+        let host = player.alloc_datum(Datum::String(host.clone()));
+        let port = player.alloc_datum(Datum::Int(port));
+        let movie = player.alloc_datum(Datum::String(parsed.movie.clone()));
+        let mode = player.alloc_datum(Datum::Int(0));
+        Ok(vec![user, password, host, port, movie, mode])
+    })?;
+    if parsed.kind.eq_ignore_ascii_case("ppH") {
+        let wait_args = reserve_player_mut(|player| {
+            let user_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("userID")));
+            let address_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("localAddress")));
+            let port_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("localTCPPort")));
+            let max_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("maxConnections")));
+            let user = player.alloc_datum(Datum::String(parsed.user.clone()));
+            let address = player.alloc_datum(Datum::String("localhost".to_string()));
+            let listener_port = player.alloc_datum(Datum::Int(port));
+            let max = player.alloc_datum(Datum::Int(parsed.max_connections));
+            let props = vec![
+                (user_key, user),
+                (address_key, address),
+                (port_key, listener_port),
+                (max_key, max),
+            ];
+            Ok(vec![
+                player.alloc_datum(Datum::PropList(props.into(), false)),
+            ])
+        })?;
+        MultiuserXtraManager::call_instance_handler(
+            "waitForNetConnection",
+            multiuser_id,
+            &wait_args,
+        )?;
+    } else {
+        MultiuserXtraManager::call_instance_handler(
+            "connectToNetServer",
+            multiuser_id,
+            &connect_args,
+        )?;
+    }
+
+    let state = manager();
+    state
+        .aliases
+        .insert(parsed.alias.to_ascii_lowercase(), instance_id);
+    state.instances.insert(
+        instance_id,
+        GoMuInstance {
+            alias: parsed.alias.clone(),
+            user: parsed.user.clone(),
+            password: parsed.password.clone(),
+            kind: parsed.kind.clone(),
+            movie: parsed.movie.clone(),
+            peer_port: parsed.peer_port,
+            max_connections: parsed.max_connections,
+            max_attempts: parsed.max_attempts,
+            keep_alive: parsed.keep_alive,
+            reconnect_interval_ms: parsed.reconnect_interval_ms,
+            reconnect_attempts: 0,
+            reconnect_pending: false,
+            reconnect_token: 0,
+            multiuser_id,
+            m_server: parsed.server,
+            // The alias slot is unused by Gut Feel's original Lingo. Carry
+            // the host identity there so a browser relay can distinguish
+            // simultaneous localhost peer listeners without altering the
+            // recipient/subject/content gameplay frames.
+            pp_con_str: if parsed.kind.eq_ignore_ascii_case("ppH") {
+                format!("peer-{};{};{};", parsed.user, port, parsed.user)
+            } else {
+                format!("localhost;{};;", port)
+            },
+            status: 0,
+            last_message: DatumRef::Void,
+            default_notify: parsed.default_notify,
+            notify_by_subject: parsed.notify_by_subject,
+        },
+    );
+    reserve_player_mut(|player| {
+        player
+            .globals
+            .insert(Symbol::from_str(&parsed.alias), shim_ref.clone());
+    });
+    Ok(shim_ref)
+}
+
+/// Rebuild only the underlying Multiuser transport while preserving the goMU
+/// alias/config object. This mirrors muClient.tryNextCon: it does not restore a
+/// group, game state, or peer-host role.
+fn reconnect_transport(instance_id: u32) -> Result<(), ScriptError> {
+    let (old_multiuser_id, user, password, server, movie, kind, peer_port, max_connections) = {
+        let instance = manager()
+            .instances
+            .get(&instance_id)
+            .ok_or_else(|| ScriptError::new("Unknown goMU instance".to_string()))?;
+        (
+            instance.multiuser_id,
+            instance.user.clone(),
+            instance.password.clone(),
+            instance.m_server.clone(),
+            instance.movie.clone(),
+            instance.kind.clone(),
+            instance.peer_port,
+            instance.max_connections,
+        )
+    };
+    if kind.eq_ignore_ascii_case("ppH") {
+        return Ok(());
+    }
+    if old_multiuser_id != 0 {
+        borrow_multiuser_manager_mut(|state| state.destroy_instance(old_multiuser_id));
+    }
+    let multiuser_id = borrow_multiuser_manager_mut(|state| state.create_instance(&vec![]));
+    if let Some(instance) = manager().instances.get_mut(&instance_id) {
+        instance.multiuser_id = multiuser_id;
+    }
+    let shim_ref = reserve_player_mut(|player| {
+        Ok(player.alloc_datum(Datum::XtraInstance(XTRA_NAME.to_string(), instance_id)))
+    })?;
+    let handler_args = reserve_player_mut(|player| {
+        let handler = player.alloc_datum(Datum::Symbol(Symbol::from_str("webMessage")));
+        Ok(vec![handler, shim_ref])
+    })?;
+    MultiuserXtraManager::call_instance_handler(
+        "setNetMessageHandler",
+        multiuser_id,
+        &handler_args,
+    )?;
+
+    let is_peer = kind.eq_ignore_ascii_case("ppC");
+    let (host, port) = split_server(&server, if is_peer { peer_port } else { 1626 });
+    let connect_args = reserve_player_mut(|player| {
+        Ok(vec![
+            player.alloc_datum(Datum::String(user)),
+            player.alloc_datum(Datum::String(password)),
+            player.alloc_datum(Datum::String(host)),
+            player.alloc_datum(Datum::Int(port)),
+            player.alloc_datum(Datum::String(movie)),
+            player.alloc_datum(Datum::Int(0)),
+        ])
+    })?;
+    // max_connections belongs to ppH and is retained only so the complete
+    // original configuration survives; reconnect_transport never elects or
+    // recreates a peer host.
+    let _ = max_connections;
+    MultiuserXtraManager::call_instance_handler("connectToNetServer", multiuser_id, &connect_args)?;
+    Ok(())
+}
+
+fn reconnect_delay(instance: &mut GoMuInstance, was_connected: bool) -> Option<u64> {
+    if !instance.keep_alive || instance.kind.eq_ignore_ascii_case("ppH") {
+        return None;
+    }
+    if was_connected {
+        instance.reconnect_attempts = 0;
+        return Some(0);
+    }
+    instance.reconnect_attempts = instance.reconnect_attempts.saturating_add(1);
+    if instance.reconnect_attempts < instance.max_attempts.max(1) {
+        Some(0)
+    } else if instance.reconnect_interval_ms > 0 {
+        instance.reconnect_attempts = 0;
+        Some(instance.reconnect_interval_ms)
+    } else {
+        None
+    }
+}
+
+fn schedule_reconnect(instance_id: u32, delay_ms: u64) {
+    let token = {
+        let Some(instance) = manager().instances.get_mut(&instance_id) else {
+            return;
+        };
+        if instance.reconnect_pending {
+            return;
+        }
+        instance.reconnect_pending = true;
+        instance.reconnect_token = instance.reconnect_token.wrapping_add(1);
+        instance.reconnect_token
+    };
+    let player_generation = unsafe { crate::player::PLAYER_GENERATION };
+    crate::player::spawn_player_local(async move {
+        if delay_ms > 0 {
+            async_std::task::sleep(std::time::Duration::from_millis(delay_ms)).await;
+        }
+        if unsafe { crate::player::PLAYER_GENERATION } != player_generation {
+            return;
+        }
+        let should_reconnect = manager()
+            .instances
+            .get_mut(&instance_id)
+            .is_some_and(|instance| {
+                if instance.reconnect_token != token || !instance.reconnect_pending {
+                    return false;
+                }
+                instance.reconnect_pending = false;
+                true
+            });
+        if should_reconnect {
+            if let Err(error) = reconnect_transport(instance_id) {
+                log::warn!(
+                    "goMU reconnect failed before WebSocket creation: {}",
+                    error.message
+                );
+            }
+        }
+    });
+}
+
+struct ParsedConfig {
+    alias: String,
+    user: String,
+    password: String,
+    server: String,
+    movie: String,
+    kind: String,
+    peer_port: i32,
+    max_connections: i32,
+    max_attempts: u32,
+    keep_alive: bool,
+    reconnect_interval_ms: u64,
+    default_notify: Option<NotifyTarget>,
+    notify_by_subject: FxHashMap<String, NotifyTarget>,
+}
+
+fn parse_config(
+    player: &crate::player::DirPlayer,
+    config: &DatumRef,
+) -> Result<ParsedConfig, ScriptError> {
+    let Datum::PropList(pairs, _) = player.get_datum(config) else {
+        return Err(ScriptError::new(
+            "goMU.muNew requires a property list".to_string(),
+        ));
+    };
+    let property = |name: &str| {
+        pairs.iter().find_map(|(key, value)| {
+            player
+                .get_datum(key)
+                .string_value()
+                .ok()?
+                .eq_ignore_ascii_case(name)
+                .then(|| value.clone())
+        })
+    };
+    let string_property = |name: &str| {
+        property(name)
+            .and_then(|value| player.get_datum(&value).string_value().ok())
+            .unwrap_or_default()
+    };
+    let (default_notify, notify_by_subject) = property("mNotify")
+        .map(|notify| parse_notify_map(player, &notify))
+        .unwrap_or_default();
+    Ok(ParsedConfig {
+        alias: string_property("mAlias"),
+        user: string_property("mUser"),
+        password: string_property("mPass"),
+        server: string_property("mServer"),
+        movie: string_property("mMovie"),
+        kind: string_property("mType"),
+        peer_port: first_port(&string_property("ppPort")).unwrap_or(1627),
+        max_connections: property("ppMaxCons")
+            .and_then(|value| player.get_datum(&value).int_value().ok())
+            .unwrap_or(10),
+        max_attempts: property("maxAtt")
+            .and_then(|value| player.get_datum(&value).int_value().ok())
+            .filter(|value| *value > 1)
+            .unwrap_or(1) as u32,
+        keep_alive: property("mKeepAlive")
+            .and_then(|value| player.get_datum(&value).int_value().ok())
+            .map_or(true, |value| value != 0),
+        reconnect_interval_ms: property("rcInt")
+            .and_then(|value| player.get_datum(&value).int_value().ok())
+            .map_or(12_000, |value| value.unsigned_abs() as u64),
+        default_notify,
+        notify_by_subject,
+    })
+}
+
+fn parse_notify_map(
+    player: &crate::player::DirPlayer,
+    notify: &DatumRef,
+) -> (Option<NotifyTarget>, FxHashMap<String, NotifyTarget>) {
+    let Datum::PropList(pairs, _) = player.get_datum(notify) else {
+        return (None, FxHashMap::default());
+    };
+    let mut default_notify = None;
+    let mut by_subject = FxHashMap::default();
+    for (key, target) in pairs {
+        let Ok(subject) = player.get_datum(key).string_value() else {
+            continue;
+        };
+        let Datum::List(_, values, _) = player.get_datum(target) else {
+            continue;
+        };
+        let Some(handler) = values
+            .front()
+            .and_then(|value| player.get_datum(value).symbol_value().ok())
+        else {
+            continue;
+        };
+        let Some(receiver) = values.get(1).cloned() else {
+            continue;
+        };
+        let target = NotifyTarget { receiver, handler };
+        if subject.eq_ignore_ascii_case("DefaultMsg") {
+            default_notify = Some(target);
+        } else {
+            by_subject.insert(subject.to_ascii_lowercase(), target);
+        }
+    }
+    (default_notify, by_subject)
+}
+
+fn split_server(server: &str, fallback_port: i32) -> (String, i32) {
+    if let Some((host, rest)) = server.split_once(';') {
+        let port = rest
+            .split(';')
+            .next()
+            .and_then(|port| port.parse().ok())
+            .unwrap_or(fallback_port);
+        return (
+            if host.is_empty() {
+                "localhost".to_string()
+            } else {
+                host.to_string()
+            },
+            port,
+        );
+    }
+    let first = server.split(';').next().unwrap_or(server);
+    let mut parts = first.rsplitn(2, ':');
+    let port = parts
+        .next()
+        .and_then(|port| port.parse().ok())
+        .unwrap_or(fallback_port);
+    let host = parts.next().unwrap_or(first).to_string();
+    (
+        if host.is_empty() {
+            "localhost".to_string()
+        } else {
+            host
+        },
+        port,
+    )
+}
+
+fn first_port(value: &str) -> Option<i32> {
+    value
+        .split(',')
+        .next()?
+        .split('-')
+        .next()?
+        .trim()
+        .parse()
+        .ok()
+}
+
+fn lookup_alias(args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let alias = reserve_player_ref(|player| {
+        args.first()
+            .map(|value| player.get_datum(value).string_value())
+            .transpose()
+    })?
+    .unwrap_or_default();
+    let instance_id = manager().aliases.get(&alias.to_ascii_lowercase()).copied();
+    reserve_player_mut(|player| match instance_id {
+        Some(id) => Ok(player.alloc_datum(Datum::XtraInstance(XTRA_NAME.to_string(), id))),
+        None => Ok(DatumRef::Void),
+    })
+}
+
+fn mu_post(instance_id: u32, args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let instance = manager()
+        .instances
+        .get(&instance_id)
+        .ok_or_else(|| ScriptError::new("Unknown goMU instance".to_string()))?;
+    let multiuser_id = instance.multiuser_id;
+    let is_peer_host = instance.kind.eq_ignore_ascii_case("ppH");
+    let sender = instance.user.clone();
+    if multiuser_id == 0 {
+        return Err(ScriptError::new(
+            "goMU root cannot send messages".to_string(),
+        ));
+    }
+    if args.len() < 2 {
+        return Err(ScriptError::new(
+            "goMU.muPost requires recipients and subject".to_string(),
+        ));
+    }
+
+    let (recipients, subject, content) = reserve_player_ref(|player| {
+        Ok((
+            player.get_datum(&args[0]).string_value()?,
+            player.get_datum(&args[1]).string_value()?,
+            args.get(2).cloned().unwrap_or(DatumRef::Void),
+        ))
+    })?;
+    if is_peer_host && recipients.eq_ignore_ascii_case("@allusers") {
+        let peer_names = borrow_multiuser_manager_mut(|manager| {
+            manager
+                .instances
+                .get(&multiuser_id)
+                .map(|instance| instance.peer_connections.clone())
+                .unwrap_or_default()
+        });
+        if peer_names.is_empty() {
+            return Ok(DatumRef::Void);
+        }
+        let relay_args = reserve_player_mut(|player| {
+            let recipients = peer_names
+                .into_iter()
+                .map(|name| player.alloc_datum(Datum::String(name)))
+                .collect();
+            let recipients = player.alloc_datum(Datum::List(
+                crate::director::lingo::datum::DatumType::List,
+                recipients,
+                false,
+            ));
+            let subject_ref = player.alloc_datum(Datum::String("pph@all".to_string()));
+            let sender_ref = player.alloc_datum(Datum::String(sender));
+            let original_subject = player.alloc_datum(Datum::String(subject));
+            let content = player.alloc_datum(Datum::List(
+                crate::director::lingo::datum::DatumType::List,
+                vec![sender_ref, original_subject, content].into(),
+                false,
+            ));
+            Ok(vec![recipients, subject_ref, content])
+        })?;
+        return MultiuserXtraManager::call_instance_handler(
+            "sendNetMessage",
+            multiuser_id,
+            &relay_args,
+        );
+    }
+    let direct_args = vec![args[0].clone(), args[1].clone(), content];
+    MultiuserXtraManager::call_instance_handler("sendNetMessage", multiuser_id, &direct_args)
+}
+
+/// Called by Multiuser after a real MUS frame arrives. Snapshot the original
+/// message object so legacy `muObj.mMsg` reads remain valid, then invoke the
+/// game's original `mNotify[#DefaultMsg]` handler with this shim as `muObj`.
+fn web_message(
+    instance_id: u32,
+) -> impl std::future::Future<Output = Result<DatumRef, ScriptError>> {
+    async move {
+        let (multiuser_id, is_peer_client) = manager()
+            .instances
+            .get(&instance_id)
+            .map(|instance| {
+                (
+                    instance.multiuser_id,
+                    instance.kind.eq_ignore_ascii_case("ppC"),
+                )
+            })
+            .unwrap_or((0, false));
+        if multiuser_id == 0 {
+            // A callback queued before an alias was killed belongs to the prior
+            // session and must not raise a script error in the replacement one.
+            return Ok(DatumRef::Void);
+        }
+        let message =
+            MultiuserXtraManager::call_instance_handler("getNetMessage", multiuser_id, &vec![])?;
+        if message == DatumRef::Void {
+            return Ok(DatumRef::Void);
+        }
+        let (target, direct_ammo_swap, shim, reconnect_after) = reserve_player_mut(|player| {
+            let shim = player.alloc_datum(Datum::XtraInstance(XTRA_NAME.to_string(), instance_id));
+            let message = unwrap_peer_broadcast(player, message);
+            let subject = message_subject(player, &message).unwrap_or_default();
+            let direct_ammo_swap = is_peer_client
+                .then(|| corrected_ammo_swap_target(player, &message))
+                .flatten();
+            let error_code = message_property(player, &message, "errorCode")
+                .and_then(|value| player.get_datum(&value).int_value().ok())
+                .unwrap_or(0);
+            let (target, reconnect_after) = manager()
+                .instances
+                .get_mut(&instance_id)
+                .map(|instance| {
+                    instance.last_message = message;
+                    let target = instance
+                        .notify_by_subject
+                        .get(&subject.to_ascii_lowercase())
+                        .or(instance.default_notify.as_ref())
+                        .map(|notify| (notify.receiver.clone(), notify.handler));
+                    let reconnect_after = if subject.eq_ignore_ascii_case("ConnectToNetServer")
+                        && error_code == 0
+                    {
+                        instance.status = 1;
+                        instance.reconnect_attempts = 0;
+                        instance.reconnect_pending = false;
+                        instance.reconnect_token = instance.reconnect_token.wrapping_add(1);
+                        None
+                    } else if subject.eq_ignore_ascii_case("ConnectionProblem")
+                        || (subject.eq_ignore_ascii_case("ConnectToNetServer") && error_code != 0)
+                    {
+                        let was_connected = instance.status > 0;
+                        instance.status = if was_connected { -2 } else { -3 };
+                        reconnect_delay(instance, was_connected)
+                    } else {
+                        None
+                    };
+                    (target, reconnect_after)
+                })
+                .unwrap_or((None, None));
+            Ok((target, direct_ammo_swap, shim, reconnect_after))
+        })?;
+        if let Some((receiver, handler, args)) =
+            select_message_dispatch(direct_ammo_swap, target, shim)
+        {
+            // Consume a single queued MUS message and await its legacy receiver
+            // before the next callback can replace `mMsg`.
+            Box::pin(player_call_datum_handler(&receiver, handler, &args)).await?;
+        }
+        if let Some(delay_ms) = reconnect_after {
+            schedule_reconnect(instance_id, delay_ms);
+        }
+        Ok(DatumRef::Void)
+    }
+}
+
+fn select_message_dispatch(
+    direct_ammo_swap: Option<(DatumRef, DatumRef)>,
+    default_target: Option<(DatumRef, Symbol)>,
+    shim: DatumRef,
+) -> Option<(DatumRef, Symbol, Vec<DatumRef>)> {
+    if let Some((receiver, direction)) = direct_ammo_swap {
+        // Main OBJ's recovered mSwapAmmo receiver reads content[1] twice,
+        // using the seat name as the direction. Native goMU's intended payload
+        // is [seatName, direction]. Dispatch only this notification directly
+        // to the original seat method so all peers rotate the same list.
+        Some((receiver, Symbol::from_str("mSwapAmmo"), vec![direction]))
+    } else {
+        default_target.map(|(receiver, handler)| (receiver, handler, vec![shim]))
+    }
+}
+
+fn ammo_swap_request(
+    player: &crate::player::DirPlayer,
+    message: &DatumRef,
+) -> Option<(String, DatumRef)> {
+    if !message_subject(player, message)
+        .is_some_and(|subject| subject.eq_ignore_ascii_case("mSwapAmmo"))
+    {
+        return None;
+    }
+    let content = message_property(player, message, "content")?;
+    let Datum::List(_, values, _) = player.get_datum(&content) else {
+        return None;
+    };
+    let seat_name = player.get_datum(values.front()?).string_value().ok()?;
+    let direction = values.get(1)?.clone();
+    matches!(player.get_datum(&direction), Datum::Int(0 | 1)).then_some((seat_name, direction))
+}
+
+fn corrected_ammo_swap_target(
+    player: &mut crate::player::DirPlayer,
+    message: &DatumRef,
+) -> Option<(DatumRef, DatumRef)> {
+    let (seat_name, direction) = ammo_swap_request(player, message)?;
+    let seats = player.globals.get(&Symbol::from_str("gSeatsList"))?.clone();
+    let candidates: Vec<DatumRef> = match player.get_datum(&seats) {
+        Datum::PropList(pairs, _) => pairs.iter().map(|(_, value)| value.clone()).collect(),
+        Datum::List(_, values, _) => values.iter().cloned().collect(),
+        _ => return None,
+    };
+    for candidate in candidates {
+        let Datum::ScriptInstanceRef(instance_ref) = player.get_datum(&candidate) else {
+            continue;
+        };
+        let instance_ref = instance_ref.clone();
+        let candidate_name = script_get_prop(player, &instance_ref, Symbol::from_str("pSeatname"))
+            .ok()
+            .and_then(|value| player.get_datum(&value).string_value().ok());
+        if candidate_name.is_some_and(|name| name.eq_ignore_ascii_case(&seat_name)) {
+            return Some((candidate, direction));
+        }
+    }
+    None
+}
+
+/// goMU peer hosts wrap broadcasts as `pph@all` with
+/// `[originalSender, originalSubject, originalContent]`. The original peer
+/// client unwraps this before invoking the game's notification handler.
+fn unwrap_peer_broadcast(player: &mut crate::player::DirPlayer, message: DatumRef) -> DatumRef {
+    if !message_subject(player, &message)
+        .is_some_and(|subject| subject.eq_ignore_ascii_case("pph@all"))
+    {
+        return message;
+    }
+    let Some(content) = message_property(player, &message, "content") else {
+        return message;
+    };
+    let Datum::List(_, values, _) = player.get_datum(&content) else {
+        return message;
+    };
+    if values.len() < 3 {
+        return message;
+    }
+    let sender = values[0].clone();
+    let subject = values[1].clone();
+    let original_content = values[2].clone();
+    let error_code = message_property(player, &message, "errorCode").unwrap_or(DatumRef::Void);
+    let recipients = message_property(player, &message, "recipients").unwrap_or(DatumRef::Void);
+    let timestamp = message_property(player, &message, "timeStamp").unwrap_or(DatumRef::Void);
+    let error_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("errorCode")));
+    let recipients_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("recipients")));
+    let sender_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("senderID")));
+    let subject_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("subject")));
+    let content_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("content")));
+    let timestamp_key = player.alloc_datum(Datum::Symbol(Symbol::from_str("timeStamp")));
+    player.alloc_datum(Datum::PropList(
+        vec![
+            (error_key, error_code),
+            (recipients_key, recipients),
+            (sender_key, sender),
+            (subject_key, subject),
+            (content_key, original_content),
+            (timestamp_key, timestamp),
+        ]
+        .into(),
+        false,
+    ))
+}
+
+fn message_property(
+    player: &crate::player::DirPlayer,
+    message: &DatumRef,
+    wanted: &str,
+) -> Option<DatumRef> {
+    let Datum::PropList(pairs, _) = player.get_datum(message) else {
+        return None;
+    };
+    pairs.iter().find_map(|(key, value)| {
+        player
+            .get_datum(key)
+            .string_value()
+            .ok()?
+            .eq_ignore_ascii_case(wanted)
+            .then(|| value.clone())
+    })
+}
+
+fn message_subject(player: &crate::player::DirPlayer, message: &DatumRef) -> Option<String> {
+    message_property(player, message, "subject")
+        .and_then(|value| player.get_datum(&value).string_value().ok())
+}
+
+fn kill_instance(instance_id: u32) -> Result<DatumRef, ScriptError> {
+    if instance_id == 0 {
+        let children: Vec<u32> = manager()
+            .instances
+            .keys()
+            .copied()
+            .filter(|id| *id != 0)
+            .collect();
+        for child in children {
+            let _ = kill_instance(child);
+        }
+        manager().aliases.remove("gomu");
+        manager().instances.remove(&0);
+        reserve_player_mut(|player| {
+            player.globals.remove(&Symbol::from_str("goMU"));
+        });
+        return Ok(DatumRef::Void);
+    }
+    if let Some(instance) = manager().instances.remove(&instance_id) {
+        manager()
+            .aliases
+            .remove(&instance.alias.to_ascii_lowercase());
+        reserve_player_mut(|player| {
+            player.globals.remove(&Symbol::from_str(&instance.alias));
+        });
+        if instance.multiuser_id != 0 {
+            borrow_multiuser_manager_mut(|manager| manager.destroy_instance(instance.multiuser_id));
+        }
+    }
+    Ok(DatumRef::Void)
+}
+
+pub fn get_prop(
+    player: &mut crate::player::DirPlayer,
+    instance_id: u32,
+    prop_name: Symbol,
+) -> Result<DatumRef, ScriptError> {
+    let instance = manager()
+        .instances
+        .get(&instance_id)
+        .ok_or_else(|| ScriptError::new("Unknown goMU instance".to_string()))?;
+    match prop_name.as_str().to_ascii_lowercase().as_str() {
+        "mmsg" => Ok(instance.last_message.clone()),
+        "mserver" => Ok(player.alloc_datum(Datum::String(instance.m_server.clone()))),
+        "ppconstr" => Ok(player.alloc_datum(Datum::String(instance.pp_con_str.clone()))),
+        "malias" => Ok(player.alloc_datum(Datum::String(instance.alias.clone()))),
+        "mstatus" => Ok(player.alloc_datum(Datum::Int(instance.status))),
+        "ppconnames" => {
+            let mut names = borrow_multiuser_manager_mut(|manager| {
+                manager
+                    .instances
+                    .get(&instance.multiuser_id)
+                    .map(|multiuser| multiuser.peer_connections.clone())
+                    .unwrap_or_default()
+            });
+            if instance.kind.eq_ignore_ascii_case("ppH") && !instance.user.is_empty() {
+                names.insert(0, instance.user.clone());
+            }
+            let names = names
+                .into_iter()
+                .map(|name| player.alloc_datum(Datum::String(name)))
+                .collect();
+            Ok(player.alloc_datum(Datum::List(
+                crate::director::lingo::datum::DatumType::List,
+                names,
+                false,
+            )))
+        }
+        _ => Ok(DatumRef::Void),
+    }
+}
+
+pub fn set_prop(instance_id: u32, prop_name: Symbol, value: DatumRef) -> Result<(), ScriptError> {
+    let instance = manager()
+        .instances
+        .get_mut(&instance_id)
+        .ok_or_else(|| ScriptError::new("Unknown goMU instance".to_string()))?;
+    if prop_name.as_str().eq_ignore_ascii_case("mMsg") {
+        instance.last_message = value;
+    }
+    Ok(())
+}
+
+fn ok_int(value: i32) -> Result<DatumRef, ScriptError> {
+    reserve_player_mut(|player| Ok(player.alloc_datum(Datum::Int(value))))
+}
+
+fn ok_list(values: &[&str]) -> Result<DatumRef, ScriptError> {
+    reserve_player_mut(|player| {
+        let values = values
+            .iter()
+            .map(|value| player.alloc_datum(Datum::String((*value).to_string())))
+            .collect();
+        Ok(player.alloc_datum(Datum::List(
+            crate::director::lingo::datum::DatumType::List,
+            values,
+            false,
+        )))
+    })
+}
+
+#[cfg(test)]
