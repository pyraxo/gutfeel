+/// Apply a Director `ALFA` child chunk to a decoded 32-bit `BITD` bitmap.
+///
+/// Director stores the colour channels and the coverage plane separately for
+/// many non-JPEG D6+ bitmap members. `decompress_bitmap` can decode the BITD
+/// pixels on its own, but the alpha bytes it reads there are not the authored
+/// coverage in that layout. The ALFA chunk is authoritative: replace the
+/// decoded alpha lane only when it expands to the whole bitmap. Keeping the
+/// RGB bytes intact is important for transparent erase images, whose invisible
+/// pixels still carry meaningful white RGB data.
+pub fn apply_external_alpha(bitmap: &mut Bitmap, alfa_data: &[u8]) -> bool {
+    if bitmap.original_bit_depth != 32 || bitmap.bit_depth != 32 {
+        return false;
+    }
+
+    let expected_len = bitmap.width as usize * bitmap.height as usize;
+    if expected_len == 0 {
+        return false;
+    }
+
+    let alpha = decompress_alpha_rle(alfa_data, bitmap.width as usize, bitmap.height as usize);
+    if alpha.len() != expected_len || bitmap.data.len() != expected_len * 4 {
+        return false;
+    }
+
+    for (pixel, alpha) in bitmap.data.chunks_exact_mut(4).zip(alpha) {
+        pixel[3] = alpha;
+    }
+    bitmap.use_alpha = true;
+    true
+}
