@@ -179,6 +179,58 @@ impl DirectorFile {
             font_table,
         });
     }
+
+    /// Drop parser/source structures after `Movie`, `CastManager`, and `Score`
+    /// have built their independent runtime representations.
+    ///
+    /// DirectorFile normally keeps every source cast member and every cached
+    /// chunk view for authoring/debug operations. For large projector movies
+    /// this duplicates compressed bitmap, sound, and XMedia bytes that the
+    /// runtime cast has already decoded or copied. Production embedders may
+    /// call this only after `onMovieLoaded`; the lightweight identity/config
+    /// fields remain available to Lingo (`findEmpty` needs min/max member).
+    pub fn compact_for_runtime(&mut self) -> DirectorFileCompactionStats {
+        let stats = DirectorFileCompactionStats {
+            cached_chunk_bytes: self
+                .chunk_container
+                .cached_chunk_views
+                .values()
+                .map(Vec::len)
+                .sum(),
+            cast_members: self.casts.iter().map(|cast| cast.members.len()).sum(),
+            memory_map_entries: self.chunk_container.chunk_info.len(),
+        };
+
+        self.casts = Vec::new();
+        self.cast_entries = Vec::new();
+        self.score = None;
+        self.tile_list = None;
+        self.frame_labels = None;
+        self.score_order = None;
+        self.media = None;
+        self.xmedia = None;
+        self.cast_info = None;
+        self.effect = None;
+        self.thum = None;
+        // Keep XTRl: the JS embedder resolves required xtras immediately after
+        // onMovieLoaded returns, so this small declaration list remains live.
+        self.key_table = None;
+        self.font_table = HashMap::new();
+        self.chunk_container = ChunkContainer {
+            cached_chunk_views: HashMap::new(),
+            chunk_info: HashMap::new(),
+            deserialized_chunks: HashMap::new(),
+        };
+
+        stats
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DirectorFileCompactionStats {
+    pub cached_chunk_bytes: usize,
+    pub cast_members: usize,
+    pub memory_map_entries: usize,
 }
 
