+fn should_render_text_source(text: &str, ink: i32) -> bool {
+    // An empty Text member still owns an authored rectangular background under
+    // Copy ink. Transparent/non-copy inks have no glyphs and no visible
+    // background to contribute, so retaining the old early-out there avoids
+    // allocating a useless fully-transparent texture.
+    !text.is_empty() || ink == 0
+}
+
+fn apply_text_background(data: &mut [u8], bg_rgb: (u8, u8, u8), has_bg_fill: bool) {
+    for pixel in data.chunks_exact_mut(4) {
+        let alpha = pixel[3];
+        if alpha == 0 {
+            if has_bg_fill {
+                pixel.copy_from_slice(&[bg_rgb.0, bg_rgb.1, bg_rgb.2, 255]);
+            }
+        } else if has_bg_fill && alpha < 255 {
+            // Canvas2D/PFR edge pixels were composited against transparent
+            // black. Re-composite them against the authored text background.
+            let alpha = alpha as u32;
+            let inv_alpha = 255 - alpha;
+            pixel[0] = ((pixel[0] as u32 * alpha + bg_rgb.0 as u32 * inv_alpha) / 255) as u8;
+            pixel[1] = ((pixel[1] as u32 * alpha + bg_rgb.1 as u32 * inv_alpha) / 255) as u8;
+            pixel[2] = ((pixel[2] as u32 * alpha + bg_rgb.2 as u32 * inv_alpha) / 255) as u8;
+            pixel[3] = 255;
+        }
+    }
+}
+
+#[cfg(test)]
+mod empty_text_tests {
+    use super::{apply_text_background, should_render_text_source};
+
+    #[test]
+    fn empty_copy_text_keeps_its_background_but_transparent_text_stays_invisible() {
+        // Gut Feel chatInput/chatOutput are empty Text members until the first
+        // message. Their authored sprites use Copy ink and a white bgColor, so
+        // Director still draws the input/history boxes while empty.
+        assert!(should_render_text_source("", 0));
+        assert!(!should_render_text_source("", 36));
+        assert!(should_render_text_source("message", 36));
+
+        let mut copy_pixels = vec![0_u8; 612 * 25 * 4];
+        apply_text_background(&mut copy_pixels, (255, 255, 255), true);
+        let center = (12 * 612 + 306) * 4;
+        assert_eq!(&copy_pixels[center..center + 4], &[255, 255, 255, 255]);
+
+        let mut transparent_pixels = vec![0_u8; 612 * 25 * 4];
+        apply_text_background(&mut transparent_pixels, (255, 255, 255), false);
+        assert_eq!(&transparent_pixels[center..center + 4], &[0, 0, 0, 0]);
+    }
+}
