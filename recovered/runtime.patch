+vm_rust::native_e2e_test!(gutfeel_client_applies_external_alfa_to_copy_reset_assets, |player| async move {
+    // This is intentionally a real recovered movie load, rather than a
+    // synthetic PNG test: the faulty route was BITD + sibling ALFA parsing.
+    player.load_movie(&browser_ready_client()).await;
+
+    let (width, height, has_alpha, reset) = bitmap_rgba_by_name("mouth_teeth_ref");
+    assert_eq!((width, height), (696, 340));
+    assert!(has_alpha);
+    assert!(
+        reset.chunks_exact(4).all(|pixel| pixel[3] == 0),
+        "mouth_teeth_ref must erase every previously selected pair on copy ink"
+    );
+
+    // Exercise the same default-ink operation Biting_point.stepFrame uses:
+    // copy the recovered all-transparent reset image over previously painted
+    // aqua teeth. This used to leave every prior selection visible.
+    let mut reset_bitmap = Bitmap::new(
+        width,
+        height,
+        32,
+        32,
+        8,
+        PaletteRef::BuiltIn(BuiltInPalette::SystemWin),
+    );
+    reset_bitmap.use_alpha = has_alpha;
+    reset_bitmap.data = reset;
+    let mut teeth_canvas = Bitmap::new(
+        width,
+        height,
+        32,
+        32,
+        8,
+        PaletteRef::BuiltIn(BuiltInPalette::SystemWin),
+    );
+    teeth_canvas.use_alpha = true;
+    for pixel in teeth_canvas.data.chunks_exact_mut(4) {
+        pixel.copy_from_slice(&[162, 250, 255, 255]);
+    }
+    teeth_canvas.copy_pixels_with_params(
+        &PaletteMap::new(),
+        &reset_bitmap,
+        IntRect::from(0, 0, width as i32, height as i32),
+        IntRect::from(0, 0, width as i32, height as i32),
+        &CopyPixelsParams::default(&reset_bitmap),
+    );
+    assert!(
+        teeth_canvas.data.chunks_exact(4).all(|pixel| pixel[3] == 0),
+        "copy ink must clear stale cyan teeth with the recovered transparent reset"
+    );
+
+    let (width, height, has_alpha, selected_pair) = bitmap_rgba_by_name("mouth_teeth_pair1");
+    assert_eq!((width, height), (106, 99));
+    assert!(has_alpha);
+    assert_eq!(selected_pair[(49 * width as usize + 53) * 4..][..4], [162, 250, 255, 179]);
+    assert_eq!(selected_pair[(0 * width as usize + 0) * 4..][..4], [255, 255, 255, 0]);
+
+    let (width, height, has_alpha, message_background) = bitmap_rgba_by_name("msg_bg");
+    assert_eq!((width, height), (796, 68));
+    assert!(has_alpha);
+    assert_eq!(
+        message_background[(34 * width as usize + 398) * 4..][..4],
+        [243, 243, 243, 196],
+        "the notice centre is authored translucent grey, so black notice text has a background"
+    );
+
+    Ok(())
+});
