+/// Relay lifecycle messages retain the original Multiuser subjects. The relay
+/// supplies the connecting user in `#userID` (or `#user` for disconnect
+/// notifications), matching the property lists goMU consumes.
+fn peer_user_from_content(content: &StaticDatum) -> Option<String> {
+    match content {
+        StaticDatum::String(user) if !user.is_empty() => Some(user.clone()),
+        StaticDatum::PropList(pairs) => pairs.iter().find_map(|(key, value)| {
+            let key = match key {
+                StaticDatum::Symbol(key) | StaticDatum::String(key) => key,
+                _ => return None,
+            };
+            if !key.eq_ignore_ascii_case("userID") && !key.eq_ignore_ascii_case("user") {
+                return None;
+            }
+            match value {
+                StaticDatum::String(user) if !user.is_empty() => Some(user.clone()),
+                _ => None,
+            }
+        }),
+        _ => None,
+    }
+}
+
+fn transport_connection_problem(reason: String) -> MultiuserMessage {
+    MultiuserMessage {
+        error_code: -1,
+        recipients: vec![],
+        sender_id: "System".to_string(),
+        subject: "ConnectionProblem".to_string(),
+        content: StaticDatum::String(reason),
+        time_stamp: 0,
+    }
+}
+
+fn peer_host_disconnect_messages(peers: Vec<String>) -> Vec<MultiuserMessage> {
+    peers
+        .into_iter()
+        .map(transport_connection_problem)
+        .collect()
