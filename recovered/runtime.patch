+    #[test]
+    fn snds_pcm_matches_the_recovered_native_bg_music_samples() {
+        // First four stereo frames from recovered/director/assets/client/raw_chunks/
+        // 89320_bgMusic_121543_sndS.bin. The Director sndS payload is signed
+        // 16-bit big-endian PCM even though its containing movie is XFIR.
+        let snds = [
+            0x02, 0x39, 0x00, 0xb5, 0xff, 0xc1, 0xfe, 0x40,
+            0xfe, 0xb5, 0xfd, 0x3d, 0xfe, 0x09, 0xfc, 0xaa,
+        ];
+        let sound = SoundChunk::from_snd_header_and_samples(
+            &gutfeel_bg_music_header(),
+            &snds,
+        );
+
+        let expected_native_pcm = [
+            0x39, 0x02, 0xb5, 0x00, 0xc1, 0xff, 0x40, 0xfe,
+            0xb5, 0xfe, 0x3d, 0xfd, 0x09, 0xfe, 0xaa, 0xfc,
+        ];
+
+        // Reproduce the shipped bug in the same decoder: the old implementation
+        // passed the XFIR container's little-endian flag through as the sample
+        // byte order. That path keeps sndS pairs unswapped and cannot match the
+        // recovered native PCM.
+        let legacy_wav = SoundChannel::load_director_sound_from_bytes(
+            &sound.data(),
+            sound.channels(),
+            sound.sample_rate(),
+            sound.bits_per_sample(),
+            &sound.codec(),
+            Some(sound.sample_count()),
+            gutfeel_bg_music_header().file_endian_is_big,
+        )
+        .expect("legacy XFIR path should produce a WAV containing corrupt PCM");
+        assert_ne!(&legacy_wav[44..60], &expected_native_pcm);
+
+        // This is the same PCM-to-WAV conversion used before browser playback.
+        let wav = SoundChannel::load_director_sound_from_bytes(
+            &sound.data(),
+            sound.channels(),
+            sound.sample_rate(),
+            sound.bits_per_sample(),
+            &sound.codec(),
+            Some(sound.sample_count()),
+            sound.big_endian_data(),
+        )
+        .expect("Gut Feel bgMusic PCM should decode");
+
+        // Exact first samples from the recovered native WAV, not a duration check.
+        assert_eq!(&wav[44..60], &expected_native_pcm);
+    }
+}
