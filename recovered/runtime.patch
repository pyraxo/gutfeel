+use std::path::Path;
+
+use vm_rust::player::{
+    bitmap::{
+        bitmap::{Bitmap, BuiltInPalette, PaletteRef},
+        drawing::CopyPixelsParams,
+        palette_map::PaletteMap,
+    },
+    cast_member::CastMemberType,
+    geometry::IntRect,
+    reserve_player_ref,
+    testing_shared::TestHarness,
+};
+
+fn browser_ready_client() -> String {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .ancestors()
+        .nth(3)
+        .expect("the embedded dirplayer checkout has a project root")
+        .join("web/public/movies/client/main.dir")
+        .to_string_lossy()
+        .into_owned()
+}
+
+fn bitmap_rgba_by_name(name: &str) -> (u16, u16, bool, Vec<u8>) {
+    reserve_player_ref(|player| {
+        let member_ref = player
+            .movie
+            .cast_manager
+            .find_member_ref_by_name(name)
+            .unwrap_or_else(|| panic!("missing recovered Gut Feel bitmap member {name}"));
+        let member = player
+            .movie
+            .cast_manager
+            .find_member_by_ref(&member_ref)
+            .unwrap_or_else(|| panic!("missing member data for {name}"));
+        let CastMemberType::Bitmap(bitmap_member) = &member.member_type else {
+            panic!("{name} is not a bitmap member");
+        };
+        let bitmap = player
+            .bitmap_manager
+            .get_bitmap(bitmap_member.image_ref)
+            .unwrap_or_else(|| panic!("missing decoded bitmap for {name}"));
+        (bitmap.width, bitmap.height, bitmap.use_alpha, bitmap.data.clone())
+    })
+}
