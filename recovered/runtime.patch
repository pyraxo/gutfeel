new file mode 100644
index 0000000..d93faeb
--- /dev/null
+++ b/vm-rust/src/player/xtra/zip/mod.rs
@@ -0,0 +1,373 @@
+//! ZipXtra compatibility for Director movies running in the browser.
+//!
+//! Gut Feel writes its AMR report through FileIO, then calls
+//! `JarFiles(directory, "Report.zip", [fileName])`. The browser replacement
+//! reads those exact bytes from FileIO's virtual filesystem, builds a standard
+//! stored ZIP archive, and starts a browser download.
+
+use log::{debug, warn};
+
+use crate::{
+    director::lingo::datum::{Datum, DatumType},
+    player::{reserve_player_mut, DatumRef, ScriptError},
+};
+
+use super::fileio::borrow_fileio_manager_mut;
+
+pub struct ZipXtra;
+
+impl ZipXtra {
+    pub fn call_instance_handler(
+        handler_name: &str,
+        _instance_id: u32,
+        args: &Vec<DatumRef>,
+    ) -> Result<DatumRef, ScriptError> {
+        match handler_name.to_ascii_lowercase().as_str() {
+            "jarfiles" => jar_files(args),
+            "version" => string_result("1.0"),
+            "interface" => string_result(
+                "-- xtra ZipXtra\nnew object me\nJarFiles string directory, string archiveName, list files",
+            ),
+            _ => Err(ScriptError::new(format!(
+                "No handler {} found for ZipXtra instance #{}",
+                handler_name, _instance_id
+            ))),
+        }
+    }
+}
+
+fn jar_files(args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    if args.len() < 3 {
+        return Err(ScriptError::new(
+            "ZipXtra.JarFiles requires directory, archive name, and file list".to_string(),
+        ));
+    }
+
+    let (directory, archive_name, requested_files) = reserve_player_mut(|player| {
+        let directory = player.get_datum(&args[0]).string_value()?;
+        let archive_name = player.get_datum(&args[1]).string_value()?;
+        let requested_files = match player.get_datum(&args[2]) {
+            Datum::List(DatumType::List, items, _) => items
+                .iter()
+                .map(|item| player.get_datum(item).string_value())
+                .collect::<Result<Vec<_>, _>>()?,
+            datum => vec![datum.string_value()?],
+        };
+        Ok((directory, archive_name, requested_files))
+    })?;
+
+    if requested_files.is_empty() {
+        return integer_result(-1);
+    }
+
+    let entries = borrow_fileio_manager_mut(|manager| {
+        requested_files
+            .iter()
+            .filter_map(|requested| {
+                find_virtual_file(&manager.virtual_fs, &directory, requested).map(|bytes| {
+                    let entry_name = archive_entry_name(requested);
+                    (entry_name, bytes)
+                })
+            })
+            .collect::<Vec<_>>()
+    });
+
+    if entries.len() != requested_files.len() {
+        warn!(
+            "ZipXtra.JarFiles: found {} of {} requested virtual files",
+            entries.len(),
+            requested_files.len()
+        );
+        return integer_result(-1);
+    }
+
+    let archive_bytes = build_stored_zip(&entries)?;
+    let download_name = archive_file_name(&archive_name);
+    borrow_fileio_manager_mut(|manager| {
+        manager
+            .virtual_fs
+            .insert(archive_name.clone(), archive_bytes.clone());
+    });
+    trigger_browser_download(&download_name, &archive_bytes, "application/zip");
+    debug!(
+        "ZipXtra.JarFiles: archived {} file(s) into '{}' ({} bytes)",
+        entries.len(),
+        download_name,
+        archive_bytes.len()
+    );
+    integer_result(0)
+}
+
+fn normalize_path(path: &str) -> String {
+    path.replace('\\', "/")
+}
+
+fn basename(path: &str) -> &str {
+    path.rsplit(['/', '\\']).next().unwrap_or(path)
+}
+
+fn find_virtual_file(
+    virtual_fs: &fxhash::FxHashMap<String, Vec<u8>>,
+    directory: &str,
+    requested: &str,
+) -> Option<Vec<u8>> {
+    let requested_normalized = normalize_path(requested);
+    let directory_normalized = normalize_path(directory);
+    let joined = format!(
+        "{}/{}",
+        directory_normalized.trim_end_matches('/'),
+        requested_normalized.trim_start_matches('/')
+    );
+    for candidate in [&requested_normalized, &joined] {
+        if let Some(bytes) = virtual_fs.get(candidate) {
+            return Some(bytes.clone());
+        }
+        if let Some((_, bytes)) = virtual_fs
+            .iter()
+            .find(|(path, _)| normalize_path(path).eq_ignore_ascii_case(candidate))
+        {
+            return Some(bytes.clone());
+        }
+    }
+
+    let requested_name = basename(&requested_normalized);
+    virtual_fs
+        .iter()
+        .find(|(path, _)| basename(path).eq_ignore_ascii_case(requested_name))
+        .map(|(_, bytes)| bytes.clone())
+}
+
+fn archive_entry_name(requested: &str) -> String {
+    let name = basename(requested);
+    if name.is_empty() || name.eq_ignore_ascii_case(".amr") {
+        "Report.amr".to_string()
+    } else {
+        name.to_string()
+    }
+}
+
+fn archive_file_name(requested: &str) -> String {
+    let name = basename(requested);
+    if name.is_empty() {
+        "Report.zip".to_string()
+    } else if name.to_ascii_lowercase().ends_with(".zip") {
+        name.to_string()
+    } else {
+        format!("{}.zip", name)
+    }
+}
+
+fn build_stored_zip(entries: &[(String, Vec<u8>)]) -> Result<Vec<u8>, ScriptError> {
+    if entries.len() > u16::MAX as usize {
+        return Err(ScriptError::new(
+            "ZipXtra archive has too many files".to_string(),
+        ));
+    }
+
+    let mut archive = Vec::new();
+    let mut central_directory = Vec::new();
+    let mut offsets = Vec::with_capacity(entries.len());
+
+    for (name, data) in entries {
+        let name_bytes = name.as_bytes();
+        if name_bytes.len() > u16::MAX as usize || data.len() > u32::MAX as usize {
+            return Err(ScriptError::new(
+                "ZipXtra archive entry is too large".to_string(),
+            ));
+        }
+        offsets.push(archive.len() as u32);
+        write_local_header(&mut archive, name_bytes, data);
+    }
+
+    let central_offset = archive.len() as u32;
+    for ((name, data), offset) in entries.iter().zip(offsets) {
+        write_central_header(&mut central_directory, name.as_bytes(), data, offset);
+    }
+    if central_directory.len() > u32::MAX as usize {
+        return Err(ScriptError::new(
+            "ZipXtra central directory is too large".to_string(),
+        ));
+    }
+    archive.extend_from_slice(&central_directory);
+    write_end_record(
+        &mut archive,
+        entries.len() as u16,
+        central_directory.len() as u32,
+        central_offset,
+    );
+    Ok(archive)
+}
+
+fn write_local_header(output: &mut Vec<u8>, name: &[u8], data: &[u8]) {
+    output.extend_from_slice(&0x04034b50u32.to_le_bytes());
+    output.extend_from_slice(&20u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&crc32(data).to_le_bytes());
+    output.extend_from_slice(&(data.len() as u32).to_le_bytes());
+    output.extend_from_slice(&(data.len() as u32).to_le_bytes());
+    output.extend_from_slice(&(name.len() as u16).to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(name);
+    output.extend_from_slice(data);
+}
+
+fn write_central_header(output: &mut Vec<u8>, name: &[u8], data: &[u8], offset: u32) {
+    output.extend_from_slice(&0x02014b50u32.to_le_bytes());
+    output.extend_from_slice(&20u16.to_le_bytes());
+    output.extend_from_slice(&20u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&crc32(data).to_le_bytes());
+    output.extend_from_slice(&(data.len() as u32).to_le_bytes());
+    output.extend_from_slice(&(data.len() as u32).to_le_bytes());
+    output.extend_from_slice(&(name.len() as u16).to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u32.to_le_bytes());
+    output.extend_from_slice(&offset.to_le_bytes());
+    output.extend_from_slice(name);
+}
+
+fn write_end_record(output: &mut Vec<u8>, entries: u16, central_size: u32, central_offset: u32) {
+    output.extend_from_slice(&0x06054b50u32.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+    output.extend_from_slice(&entries.to_le_bytes());
+    output.extend_from_slice(&entries.to_le_bytes());
+    output.extend_from_slice(&central_size.to_le_bytes());
+    output.extend_from_slice(&central_offset.to_le_bytes());
+    output.extend_from_slice(&0u16.to_le_bytes());
+}
+
+fn crc32(data: &[u8]) -> u32 {
+    let mut crc = 0xffff_ffffu32;
+    for byte in data {
+        crc ^= *byte as u32;
+        for _ in 0..8 {
+            crc = if crc & 1 == 1 {
+                (crc >> 1) ^ 0xedb8_8320
+            } else {
+                crc >> 1
+            };
+        }
+    }
+    !crc
+}
+
+#[cfg(target_arch = "wasm32")]
+fn trigger_browser_download(filename: &str, data: &[u8], mime_type: &str) {
+    use js_sys::{Array, Uint8Array};
+    use wasm_bindgen::JsCast;
+
+    let bytes = Uint8Array::from(data);
+    let parts = Array::new();
+    parts.push(&bytes.buffer());
+    let options = web_sys::BlobPropertyBag::new();
+    options.set_type(mime_type);
+    let Ok(blob) = web_sys::Blob::new_with_buffer_source_sequence_and_options(&parts, &options)
+    else {
+        return;
+    };
+    let Some(window) = web_sys::window() else {
+        return;
+    };
+    // Publish the exact archive Blob before attempting the automatic click.
+    // An async Director handler may no longer carry browser user activation,
+    // so the shell can retain this Blob behind an explicit download link when
+    // Chrome/Safari suppress the automatic download.
+    let event_init = web_sys::CustomEventInit::new();
+    let detail = js_sys::Object::new();
+    let _ = js_sys::Reflect::set(&detail, &"filename".into(), &filename.into());
+    let _ = js_sys::Reflect::set(&detail, &"mimeType".into(), &mime_type.into());
+    let _ = js_sys::Reflect::set(&detail, &"size".into(), &(data.len() as u32).into());
+    let _ = js_sys::Reflect::set(&detail, &"blob".into(), &blob);
+    event_init.set_detail(&detail);
+    if let Ok(event) = web_sys::CustomEvent::new_with_event_init_dict(
+        "dirplayer:fileDownload",
+        &event_init,
+    ) {
+        let _ = window.dispatch_event(&event);
+    }
+
+    let Ok(url) = web_sys::Url::create_object_url_with_blob(&blob) else {
+        return;
+    };
+    let Some(document) = window.document() else {
+        return;
+    };
+    let Ok(anchor) = document.create_element("a") else {
+        return;
+    };
+    let _ = anchor.set_attribute("href", &url);
+    let _ = anchor.set_attribute("download", filename);
+    let _ = anchor.set_attribute("style", "display:none");
+    if let Some(body) = document.body() {
+        let _ = body.append_child(&anchor);
+        if let Some(element) = anchor.dyn_ref::<web_sys::HtmlElement>() {
+            element.click();
+        }
+        let _ = body.remove_child(&anchor);
+    }
+    let _ = web_sys::Url::revoke_object_url(&url);
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn trigger_browser_download(_filename: &str, _data: &[u8], _mime_type: &str) {}
+
+fn integer_result(value: i32) -> Result<DatumRef, ScriptError> {
+    reserve_player_mut(|player| Ok(player.alloc_datum(Datum::Int(value))))
+}
+
+fn string_result(value: &str) -> Result<DatumRef, ScriptError> {
+    let value = value.to_string();
+    reserve_player_mut(|player| Ok(player.alloc_datum(Datum::String(value))))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{archive_entry_name, build_stored_zip, find_virtual_file};
+
+    #[test]
+    fn resolves_the_host_fallback_amr_path_without_changing_bytes() {
+        let xml = b"<GAME/>".to_vec();
+        let mut virtual_fs = fxhash::FxHashMap::default();
+        virtual_fs.insert(".amr".to_string(), xml.clone());
+
+        assert_eq!(find_virtual_file(&virtual_fs, ".am/", ".amr"), Some(xml));
+        assert_eq!(archive_entry_name(".amr"), "Report.amr");
+    }
+
+    #[test]
+    fn builds_a_stored_zip_with_the_original_amr_bytes() {
+        let xml = b"<GAME><HOST NAME=\"Teacher\"/></GAME>".to_vec();
+        let archive = build_stored_zip(&[(archive_entry_name(".amr"), xml.clone())]).unwrap();
+        assert_eq!(&archive[0..4], b"PK\x03\x04");
+        assert_eq!(u16::from_le_bytes([archive[8], archive[9]]), 0);
+        assert_eq!(
+            u32::from_le_bytes([archive[14], archive[15], archive[16], archive[17]]),
+            0xe428_92da
+        );
+        assert_eq!(
+            u32::from_le_bytes([archive[18], archive[19], archive[20], archive[21]]),
+            xml.len() as u32
+        );
+        let name_length = u16::from_le_bytes([archive[26], archive[27]]) as usize;
+        assert_eq!(&archive[30..30 + name_length], b"Report.amr");
+        assert_eq!(
+            &archive[30 + name_length..30 + name_length + xml.len()],
+            xml
+        );
+        assert!(archive.windows(4).any(|window| window == b"PK\x01\x02"));
+        assert_eq!(
+            &archive[archive.len() - 22..archive.len() - 18],
+            b"PK\x05\x06"
+        );
+    }
+}
