+fn numeric_value(value: StaticDatum) -> Result<(f64, bool), std::io::Error> {
+    match value {
+        StaticDatum::Int(value) => Ok((value as f64, false)),
+        StaticDatum::Float(value) => Ok((value, true)),
+        other => Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!("MUS coordinate must be integer or float, got {other:?}"),
+        )),
+    }
+}
+
+fn numeric_point(x: StaticDatum, y: StaticDatum) -> Result<StaticDatum, std::io::Error> {
+    let (x, x_float) = numeric_value(x)?;
+    let (y, y_float) = numeric_value(y)?;
+    let flags = u8::from(x_float) | (u8::from(y_float) << 1);
+    if flags == 0 {
+        Ok(StaticDatum::IntPoint(x as i32, y as i32))
+    } else {
+        Ok(StaticDatum::Point([x, y], flags))
+    }
+}
+
+fn numeric_rect(values: [StaticDatum; 4]) -> Result<StaticDatum, std::io::Error> {
+    let mut result = [0_f64; 4];
+    let mut flags = 0_u8;
+    for (index, value) in values.into_iter().enumerate() {
+        let (value, is_float) = numeric_value(value)?;
+        result[index] = value;
+        flags |= u8::from(is_float) << index;
+    }
+    if flags == 0 {
+        Ok(StaticDatum::IntRect(
+            result[0] as i32,
+            result[1] as i32,
+            result[2] as i32,
+            result[3] as i32,
+        ))
+    } else {
+        Ok(StaticDatum::Rect(result, flags))
+    }
+}
+
+fn read_sized_bytes(reader: &mut BinaryReader) -> Result<Vec<u8>, std::io::Error> {
+    let len = reader.read_u32()? as usize;
+    let data = reader.read_bytes(len)?.to_vec();
+    if len % 2 != 0 {
+        reader.read_u8()?;
+    }
+    Ok(data)
+}
