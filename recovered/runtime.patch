+vm_rust::native_e2e_test!(gutfeel_zero_hardness_accepts_void_rect_coordinates, |player| async move {
+    // Exercise the VM builtin that compiled Lingo actually calls. The MCP
+    // expression evaluator has its own rect() shortcut, which already accepts
+    // VOID and therefore cannot reproduce this game-stopping regression.
+    let empty = TypeHandlers::rect(&vec![DatumRef::Void; 4])
+        .expect("Director numeric coercion turns the food handler's unset locals into zero");
+    reserve_player_ref(|vm| match vm.get_datum(&empty) {
+        Datum::Rect(values, flags) => {
+            assert_eq!(*values, [0.0; 4]);
+            assert_eq!(*flags, 0);
+        }
+        other => panic!("expected empty rectangle, got {}", other.type_str()),
+    });
+
+    let args = reserve_player_mut(|vm| vec![
+        DatumRef::Void,
+        vm.alloc_datum(Datum::Float(-1.5)),
+        vm.alloc_datum(Datum::Int(10)),
+        DatumRef::Void,
+    ]);
+    let mixed = TypeHandlers::rect(&args).expect("mixed numeric and VOID coordinates");
+    reserve_player_ref(|vm| match vm.get_datum(&mixed) {
+        Datum::Rect(values, flags) => {
+            assert_eq!(*values, [0.0, -1.5, 10.0, 0.0]);
+            assert_eq!(*flags, 2);
+        }
+        other => panic!("expected mixed rectangle, got {}", other.type_str()),
+    });
+    let invalid = reserve_player_mut(|vm| vm.alloc_datum(Datum::String("not a coordinate".into())));
+    assert!(TypeHandlers::rect(&vec![invalid, DatumRef::Void, DatumRef::Void, DatumRef::Void]).is_err());
+
+    // Reproduce the original call site as well as the primitive seam. These
+    // fixture containers provide only the surrounding room state; the food
+    // constructor and calculateValues below execute recovered Client bytecode.
+    let movie = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .ancestors().nth(3).unwrap().join("web/public/movies/client/main.dir");
+    player.load_movie(&movie.to_string_lossy()).await;
+    player.eval("gMouthRoom = [#pScreensList: [#chew: [#pFoodList: [#FdName: \"burger\", #HardnessLvl: 100, #SalivaLvl: 0]]], #RmObjects: [#InteractiveObjs: []]]").await.unwrap();
+    player.eval("rectFoodFixture = script(\"Fd_In_Mouth_Obj\").new()").await.unwrap();
+    player.eval("gMouthRoom.pScreensList.chew.pFoodList[#HardnessLvl] = 0").await.unwrap();
+    player.eval("rectFoodFixture.calculateValues(0, 0)").await
+        .expect("fully softened food must not stop the original movie");
+    Ok(())
+});
