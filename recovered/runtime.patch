+    fn gutfeel_bg_music_header() -> SndHeaderChunk {
+        SndHeaderChunk {
+            offset: 0,
+            size: 10_916_388,
+            playback_start: 0,
+            playback_start_frame: 0,
+            loop_start: 0,
+            loop_start_frame: 0,
+            loop_end: 0,
+            loop_end_frame: 0,
+            playback_end: 10_916_388,
+            playback_end_frame: 2_728_073,
