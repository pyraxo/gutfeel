+// -- INI files --------------------------------------------------------------
+
+/// Windows' INI lookup is case-insensitive. Normalizing separators and case
+/// lets the browser preload URL work with a Director `the moviePath` using
+/// Windows separators.
+fn normalize_ini_path(path: &str) -> String {
+    path.replace('\\', "/")
+        .split('/')
+        .filter(|segment| !segment.is_empty() && *segment != ".")
+        .collect::<Vec<_>>()
+        .join("/")
+        .to_ascii_lowercase()
+}
+
+fn ini_basename(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// Match an exact normalized path first. If a browser has supplied an
+/// absolute URL while Director reports a movie-relative path, accept a unique
+/// suffix match. A basename-only request is deliberately rejected when more
+/// than one preloaded file has that basename, so Client and Tutorial configs
+/// cannot be mixed accidentally.
+fn preloaded_ini_contents(path: &str) -> Option<String> {
+    let requested = normalize_ini_path(path);
+    let requested_basename = ini_basename(&requested);
+    PRELOADED_INI_FILES.with(|cache| {
+        let files = cache.borrow();
+        if let Some(exact) = files.iter().find(|file| file.normalized_path == requested) {
+            return Some(exact.contents.clone());
+        }
+
+        let suffix_matches: Vec<&PreloadedIniFile> = files
+            .iter()
+            .filter(|file| {
+                file.normalized_path.ends_with(&requested)
+                    || requested.ends_with(&file.normalized_path)
+            })
+            .collect();
+        if suffix_matches.len() == 1 {
+            return Some(suffix_matches[0].contents.clone());
+        }
+
+        let basename_matches: Vec<&PreloadedIniFile> = files
+            .iter()
+            .filter(|file| ini_basename(&file.normalized_path) == requested_basename)
+            .collect();
+        if basename_matches.len() == 1 {
+            return Some(basename_matches[0].contents.clone());
+        }
+
+        None
+    })
+}
