+vm_rust::native_e2e_test!(gutfeel_biting_point_keeps_only_the_active_pair_after_two_steps, |player| async move {
+    player.load_movie(&browser_ready_client()).await;
+
+    // Use the recovered actor itself. Force two elapsed selection intervals:
+    // it must move from pair 1 to pair 2 by resetting from the transparent
+    // reference before painting the new pair.
+    for command in [
+        "gBitingPoint = script(\"Biting_point\").new()",
+        "gBitingPoint.theGlowPointChange = -1000",
+        "gBitingPoint.stepFrame()",
+        "gBitingPoint.theGlowPointChange = -1000",
+        "gBitingPoint.stepFrame()",
+    ] {
+        player.eval(command).await.map_err(|error| error.to_string())?;
+    }
+
+    let (width, height, has_alpha, teeth) = bitmap_rgba_by_name("mouth_teeth");
+    assert_eq!((width, height), (696, 340));
+    assert!(has_alpha);
+    assert_eq!(
+        teeth[(200 * width as usize + 68) * 4..][..4],
+        [255, 255, 255, 0],
+        "the first pair is cleared when the selector advances to pair 2"
+    );
+    assert_eq!(
+        teeth[(174 * width as usize + 156) * 4..][..4],
+        [162, 250, 255, 179],
+        "the second active pair is painted at its authored rect offset"
+    );
+    assert_eq!(
+        teeth.chunks_exact(4).filter(|pixel| pixel[3] != 0).count(),
+        8_481,
+        "only mouth_teeth_pair2 coverage survives the reset-and-repaint sequence"
+    );
+
+    Ok(())
+});
