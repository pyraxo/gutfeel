+    /// Move a completed task's byte payload out of the network cache while
+    /// leaving the task in a completed state. This is for embedders that know
+    /// they will not ask Director to retrieve the same URL again after parsing
+    /// it (Gut Feel's large main movie is one such immutable boot resource).
+    ///
+    /// `get_task_result` clones the payload because ordinary Director movies
+    /// can reuse `netTextResult` / linked media. Moving is therefore explicit
+    /// and opt-in; the cached result becomes `Ok([])` so `netDone` remains true.
+    pub fn take_task_result_payload(&mut self, task_id: u32) -> Option<NetResult> {
+        let mut shared_state = self.shared_state.try_lock()?;
+        let state = shared_state.task_states.get_mut(&task_id)?;
+        match state.result.as_mut()? {
+            Ok(bytes) => Some(Ok(std::mem::take(bytes))),
+            Err(code) => Some(Err(*code)),
+        }
+    }
+
